{
  "name": "@koloda/electron",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/electron/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:desktop"
  ],
  "implicitDependencies": [
    "@koloda/electron-react",
    "koloda"
  ],
  "targets": {
    "build-rust": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/target/release"
      ],
      "options": {
        "commands": [
          "cargo build -p koloda-electron --release",
          "bunx tsx scripts/copy-native-addon.ts"
        ],
        "parallel": false,
        "cwd": "apps/electron"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "serve",
          "projects": [
            "@koloda/electron-react"
          ],
          "params": "forward"
        },
        {
          "target": "build-rust"
        }
      ],
      "options": {
        "commands": [
          "bunx swc src/preload.ts -o dist/preload.js -C module.type=commonjs",
          "electron -r tsx/esm ."
        ],
        "parallel": false,
        "cwd": "apps/electron"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "@koloda/electron-react"
          ],
          "params": "forward"
        },
        {
          "target": "build-rust"
        }
      ],
      "options": {
        "commands": [
          "bunx swc src/preload.ts -o dist/preload.js -C module.type=commonjs",
          "bunx tsx scripts/bundle-main.ts",
          "bunx tsx scripts/copy-native-release.ts",
          "node ../../node_modules/electron-builder/cli.js"
        ],
        "parallel": false,
        "cwd": "apps/electron"
      },
      "configurations": {
        "production": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx vitest run --config apps/electron/vitest.config.mjs --configLoader runner",
          "bunx nx run @koloda/electron-react:test",
          "bunx nx run electron-e2e:e2e"
        ],
        "parallel": false
      },
      "configurations": {
        "unit": {
          "commands": [
            "bunx vitest run --config apps/electron/vitest.config.mjs --configLoader runner",
            "bunx nx run @koloda/electron-react:test"
          ]
        },
        "e2e": {
          "commands": [
            "bunx nx run electron-e2e:e2e"
          ]
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build --emitDeclarationOnly",
        "cwd": "apps/electron"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --deny correctness",
        "cwd": "apps/electron"
      }
    }
  }
}
