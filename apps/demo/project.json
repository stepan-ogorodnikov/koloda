{
  "name": "@koloda/demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/demo/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:web"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx playwright test --config apps/demo-e2e/playwright.config.ts"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config apps/demo/vitest.config.mjs --configLoader runner"
      }
    },
    "lingui-extract": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui extract"
      }
    },
    "linge": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui extract --clean"
      }
    },
    "lingui-compile": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui compile"
      }
    },
    "lingc": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui compile"
      }
    }
  }
}
