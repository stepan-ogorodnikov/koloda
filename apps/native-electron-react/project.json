{
  "name": "@koloda/native-electron-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "type:app",
    "platform:desktop"
  ],
  "sourceRoot": "apps/native-electron-react/src",
  "projectType": "application",
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "port": 3000
      }
    },
    "lingui-extract": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui extract"
      }
    },
    "linge": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui extract --clean"
      }
    },
    "lingui-compile": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui compile"
      }
    },
    "lingc": {
      "executor": "nx:run-script",
      "options": {
        "script": "lingui compile"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "command": "bunx vitest run --config apps/native-electron-react/vitest.config.mjs --configLoader runner"
      },
      "configurations": {}
    }
  }
}
