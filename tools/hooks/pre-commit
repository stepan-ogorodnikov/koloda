#!/bin/sh
# Wired via core.hooksPath (set by the "prepare" script in package.json).
#
# Commit boundary: local, per-file checks — fast, true regardless of the rest
# of the change, so intermediate commits of a bigger change still pass them.
# Whole-program checks (typecheck, rust tests) run in CI before main can move.
# Clippy is `koloda:lint`, cached. It and `koloda:test` share dist/target/koloda.
# Escape hatch: git commit --no-verify.

command -v bun >/dev/null 2>&1 || exit 0

# Format the staged files and fold the fixes into this commit. dprint has no
# option to re-stage itself, so re-add exactly the files that were staged,
# minus deletions: git add fails on a deleted path and re-adds nothing.
# It formats working-tree content: for partially staged files this folds the
# unstaged edits into the commit too — format before staging in that case.
# Covers TS/TSX/JSON/CSS/YAML/HTML and .rs (via rustfmt --edition 2021).
# The binary is the dprint devDependency, so a commit uses the same version
# as CI and does not depend on a global install. Skip when it is not installed.
if [ -e node_modules/.bin/dprint ] || [ -e node_modules/.bin/dprint.exe ]; then
  bunx dprint fmt --staged --allow-no-files || exit 1
  git diff --cached --name-only --diff-filter=d -z | xargs -0 -r git add --
fi

# Oxlint lints the whole workspace in one process. Clippy is `koloda:lint`
# and is skipped when Rust inputs are unchanged. Runs after formatting so
# it sees the final content.
exec bun run check:commit
