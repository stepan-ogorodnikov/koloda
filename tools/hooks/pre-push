#!/bin/sh
# Wired via core.hooksPath (set by the "prepare" script in package.json).
#
# Push boundary: whole-program checks on the state being published.
# Intermediate commits of a bigger change are never checked here — only the
# pushed tip is (the working tree at push time stands in for it).
# Escape hatch: git push --no-verify for an intentionally dirty push.

command -v bun >/dev/null 2>&1 || exit 0

# TypeScript: lint + typecheck across the workspace (nx-cached, fast).
bun run check:push || exit 1

# Rust: clippy, warnings denied.
if command -v cargo >/dev/null 2>&1; then
  bun run check:rust || exit 1
fi

# Tests last (slowest, whole-change). Not nx-cached — a flat ~50s cost per
# push. TS libs via vitest (PGlite/in-memory SQLite, self-contained; the
# Playwright e2e suites are a separate, manual/demo-deploy boundary).
# Rust: the TS <-> Rust twin rule (agents/TESTING.md) means both sides must
# actually run, not just be claimed green.
bun run test:libs || exit 1

if command -v cargo >/dev/null 2>&1; then
  cargo test -p koloda-core || exit 1
fi
