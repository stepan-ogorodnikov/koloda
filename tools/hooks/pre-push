#!/bin/sh
# Wired via core.hooksPath (set by the "prepare" script in package.json).
#
# Full suite only when publishing main. Any other remote ref (feature/PR
# branches, tags, deletes) skips these checks. PR and cloud intermediate
# pushes are intentionally unchecked here.
# Escape hatch: git push --no-verify for an intentionally dirty main push.

command -v bun >/dev/null 2>&1 || exit 0

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_main=1
  fi
done

if [ "$pushing_main" -eq 0 ]; then
  echo "pre-push: skipping suite (non-main ref)" >&2
  exit 0
fi

# TypeScript lint + typecheck, plus cached Rust clippy and `koloda` tests.
bun run check:push || exit 1

# TS libs via vitest (PGlite/in-memory SQLite, self-contained; the
# Playwright e2e suites are a separate, manual/web-deploy boundary).
bun run test:libs || exit 1
