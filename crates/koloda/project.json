{
  "name": "koloda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "crates/koloda/src",
  "projectType": "library",
  "tags": ["lang:rust"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "rust",
        "{workspaceRoot}/crates/**/*",
        "{workspaceRoot}/apps/electron/src-rust/**/*",
        "!{workspaceRoot}/crates/**/*.md"
      ],
      "options": {
        "command": "cargo clippy --workspace --all-targets -- -D warnings",
        "forwardAllArgs": false,
        "env": {
          "CARGO_TARGET_DIR": "dist/target/koloda"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "rust",
        "{workspaceRoot}/crates/koloda-sync-proto/**/*",
        "!{workspaceRoot}/crates/koloda-sync-proto/**/*.md"
      ],
      "options": {
        "command": "cargo test -p koloda",
        "forwardAllArgs": false,
        "env": {
          "CARGO_TARGET_DIR": "dist/target/koloda"
        }
      }
    }
  }
}
